# Backend Environment Variables

# Server port
PORT=8080

# Allowed origin for CORS (Next.js frontend)
ALLOWED_ORIGIN=http://localhost:3000

# JWT Configuration
# Use a strong, random string for security - MUST change in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase Configuration
# Get these values from your Supabase Dashboard -> Settings -> API

# Supabase Project URL (format: https://xxxxx.supabase.co)
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase PostgreSQL Password
# Available in Database section -> Connection Info
SUPABASE_PG_PASSWORD=your_postgres_password

# Supabase PostgreSQL User (usually 'postgres')
SUPABASE_PG_USER=postgres

# Supabase Database Name (usually 'postgres')
SUPABASE_PG_DATABASE=postgres

